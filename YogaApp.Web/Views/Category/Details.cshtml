@model CategoryDetailViewModel

@section Styles {
    <link rel="stylesheet" href="~/css/pose-tables.css" asp-append-version="true">
}

<div class="d-flex flex-column text-center">
    <h2 class mb-5>@Model.CategoryName</h2>
    <p><strong>Description:</strong> @Model.CategoryDescription</p>
    <p><strong>Poses in this category:</strong></p>
</div>




<div class="grid grid-2">
    @foreach (var pose in Model.PoseLink)
    {
        <a href="@Url.Action("Details", "Pose", new { id = pose.PoseId })" class="card-link">
            <div class="card" id="table-card">
                <img src="@(!string.IsNullOrEmpty(pose.ThumbnailLocalPath) ? pose.ThumbnailLocalPath : pose.ThumbnailSvg)"
                     alt="@pose.PoseName"
                     class="pose-thumbnail" />
                <div class="pose-info">
                    <h3>@pose.PoseName</h3>
                </div>
            </div>
        </a>
    }
</div>

